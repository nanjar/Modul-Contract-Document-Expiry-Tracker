PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expiry_tracker?schema=public"
JWT_SECRET="change-me"
FRONTEND_URL="http://localhost:3000"

# n8n integration
N8N_WEBHOOK_URL=https://theworkflow.nanjarbudiman.com/webhook/contract-tracker/office-events
N8N_WEBHOOK_SECRET=

# Telegram Bot (used by the n8n Telegram workflow; never commit real secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Notification
NOTIFICATION_EMAIL_MODE=console
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Biznet Gio S3-compatible Object Storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_MAX_FILE_SIZE_MB=20
