generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERUSER
  EDITOR
  VIEWER
}

enum ModuleKey {
  CONTRACT_DOCUMENT
  OFFICE_AUTOMATION
}

enum OfficeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  IN_PROGRESS
  COMPLETED
}

enum OfficeRequestType {
  LEAVE
  ATTENDANCE
  GENERAL
}

enum IntegrationEventStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents          Document[]             @relation("DocumentOwner")
  createdDocs        Document[]             @relation("DocumentCreator")
  audits             AuditLog[]
  moduleAccess       UserModuleAccess[]
  telegramIdentities UserTelegramIdentity[]
  officeRequests     OfficeRequest[]         @relation("OfficeRequester")
  assignedTasks      OfficeTask[]            @relation("OfficeTaskAssignee")
  approvals          OfficeApproval[]        @relation("OfficeApprover")
}

model UserModuleAccess {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  module      ModuleKey
  permissions String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([module])
}

model UserTelegramIdentity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  chatId     String   @unique
  username   String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id               String    @id @default(uuid()) @db.Uuid
  documentNumber   String?
  title            String
  documentType     String
  description      String?
  counterparty     String?
  ownerId          String?   @db.Uuid
  issueDate        DateTime?
  effectiveDate    DateTime?
  expiryDate       DateTime?
  reminderEnabled  Boolean   @default(true)
  storageKey       String?
  originalFilename String?
  mimeType         String?
  fileSize         BigInt?
  createdById      String    @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?
  archivedById     String?   @db.Uuid

  owner     User?      @relation("DocumentOwner", fields: [ownerId], references: [id])
  createdBy User       @relation("DocumentCreator", fields: [createdById], references: [id])
  reminders Reminder[]

  @@index([expiryDate])
  @@index([documentType])
  @@index([archivedAt])
}

model Reminder {
  id           String    @id @default(uuid()) @db.Uuid
  documentId   String    @db.Uuid
  daysBefore   Int
  enabled      Boolean   @default(true)
  lastSentAt   DateTime?
  processingAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, daysBefore])
  @@index([processingAt])
}

model OfficeRequest {
  id            String             @id @default(uuid()) @db.Uuid
  requestNumber String             @unique
  type          OfficeRequestType
  requesterId   String             @db.Uuid
  title         String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  requiredDate  DateTime?
  priority      String             @default("NORMAL")
  status        OfficeRequestStatus @default(PENDING)
  requestedAt   DateTime           @default(now())
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  cancelledAt   DateTime?
  completedAt   DateTime?

  requester  User              @relation("OfficeRequester", fields: [requesterId], references: [id])
  tasks      OfficeTask[]
  approvals  OfficeApproval[]
  activities OfficeActivityLog[]

  @@index([requesterId, status])
  @@index([type, status])
  @@index([requiredDate])
  @@index([requestedAt])
}

model OfficeTask {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  title       String
  description String?
  assigneeId  String?  @db.Uuid
  priority    String   @default("NORMAL")
  status      String   @default("OPEN")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request  OfficeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignee User?         @relation("OfficeTaskAssignee", fields: [assigneeId], references: [id])

  @@index([assigneeId, status])
  @@index([dueDate, status])
}

model OfficeApproval {
  id           String             @id @default(uuid()) @db.Uuid
  requestId    String             @db.Uuid
  approverId   String             @db.Uuid
  status       OfficeRequestStatus @default(PENDING)
  comment      String?
  decidedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  request  OfficeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User          @relation("OfficeApprover", fields: [approverId], references: [id])

  @@index([approverId, status])
  @@index([requestId, status])
}

model OfficeActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  request OfficeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
}

model IntegrationEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  event         String
  entityId      String?
  payload       Json
  status        IntegrationEventStatus @default(PENDING)
  attempts      Int                    @default(0)
  availableAt   DateTime               @default(now())
  processedAt   DateTime?
  lastError     String?
  idempotencyKey String                @unique
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, availableAt])
  @@index([event, entityId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entityId  String?
  entity    String
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
