        "jsCode": "const body = $json.body ?? $json;\nconst event = String(body.event ?? '');\nconst eventId = String(body.event_id ?? body.eventId ?? '');\nconst payload = body.payload ?? {};\nconst secret = String($env.N8N_OFFICE_EVENT_SECRET ?? '');\nconst suppliedSecret = String(body.secret ?? '');\n\nif (!secret || suppliedSecret !== secret) {\n  throw new Error('Unauthorized office integration event');\n}\n\nif (!eventId) throw new Error('Missing event_id');\n\nreturn [{ json: { event, eventId, payload } }];"
      },
